generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Read-only copy of Shopify orders, kept current by webhooks and the backfill. Money is in minor units (pence).
model Order {
  id               String    @id @default(cuid())
  shop             String
  orderId          String
  name             String
  createdAt        DateTime
  cancelledAt      DateTime?
  shopifyUpdatedAt DateTime
  customerName     String?
  email            String?
  shippingAddress  String?
  billingAddress   String?
  financialStatus  String?
  currency         String
  subtotalMinor    Int
  discountMinor    Int
  shippingMinor    Int
  totalMinor       Int
  tags             String[]
  sourceName       String?
  site             String?
  orderStatusId    Int?
  gateway          String?
  outstandingMinor Int       @default(0)
  refundedMinor    Int       @default(0)
  phone            String?
  postcode         String?
  orderTakenBy     String?
  orderSource      String?
  archivedAt       DateTime?
  brands           String[]
  lineStatusIds    Int[]
  syncedAt         DateTime  @default(now()) @updatedAt

  @@unique([shop, orderId])
  @@index([shop, createdAt])
  @@index([shop, archivedAt, createdAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  sku           String?
  vendor        String?
  variantTitle  String?
  productId     String?
  variantId     String?
  title         String
  quantity      Int
  currency      String
  priceMinor    Int
  discountMinor Int
  properties    Json
  lineStatusId    Int?
  expectedDate    String?
  deliveryOutcome String?
  stockedDate     String? // YYYY-MM-DD the line last came into stock (status 4); kept when it moves on
  orderCreatedAt  DateTime @default(now())
  orderArchived   Boolean  @default(false)

  @@index([shop, orderId])
  @@index([shop, sku])
  @@index([shop, vendor, orderCreatedAt])
  @@index([shop, lineStatusId])
}

// Supplier invoice details for one order line, entered by staff (the legacy "Supplier Invoice Update").
model LineSupplierInvoice {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  invoiceDate   String? // YYYY-MM-DD
  invoiceNumber String?
  amountMinor   Int?
  paid          Boolean  @default(false)
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, lineId])
  @@index([shop, orderId])
}

// One saved configuration of one configured order line. Version 1 is the original from the
// configurator; later versions are staff changes. The newest applied version is the current one.
model LineConfiguration {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineItemId    String
  version       Int
  source        String // original | staff
  configuration Json
  unitMinor     Int
  deltaMinor    Int      @default(0)
  status        String // pending | applied | failed
  reason        String?
  actorId       String?
  actorName     String?
  adjustment    Json?
  createdAt     DateTime @default(now())

  @@unique([shop, lineItemId, version])
  @@index([shop, orderId])
}

// One email: queued, sent or failed. This table is both the queue and the send log.
model EmailOutbox {
  id              String    @id @default(cuid())
  shop            String
  orderId         String
  orderName       String
  templateKey     String
  templateVersion Int
  kind            String // customer | internal_copy | test
  recipient       String?
  from            String
  replyTo         String?
  subject         String
  html            String
  status          String // queued | sending | sent | failed | skipped
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  claimedAt       DateTime?
  mode            String? // log | test | live, as at send time
  providerId      String?
  error           String?
  actorId         String?
  actorName       String?
  dedupeKey       String
  createdAt       DateTime  @default(now())
  sentAt          DateTime?

  @@unique([shop, dedupeKey])
  @@index([shop, orderId])
  @@index([status, nextAttemptAt])
}

// An email template staff can edit. `version` is the current one; every save also writes an EmailTemplateVersion row.
model EmailTemplate {
  id            String   @id @default(cuid())
  shop          String
  key           String
  subject       String
  body          String
  version       Int      @default(1)
  updatedAt     DateTime @default(now()) @updatedAt
  updatedById   String?
  updatedByName String?

  @@unique([shop, key])
}

model EmailTemplateVersion {
  id        String   @id @default(cuid())
  shop      String
  key       String
  version   Int
  subject   String
  body      String
  reason    String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@unique([shop, key, version])
}

// One brand: its name, links, addresses and phone, used to fill templates for orders of that site.
model EmailSite {
  id                 String @id @default(cuid())
  shop               String
  code               String
  name               String
  url                String
  serviceEmail       String
  deliveriesEmail    String
  accountsEmail      String
  phone              String
  fromName           String
  deliveriesFromName String
  logoUrl            String

  @@unique([shop, code])
}

// A request to refund an order (all or part), entered by staff. Accounts act on the list; nothing here moves money.
model RefundRequest {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  orderName     String
  clientKey     String
  reason        String
  type          String // part | full
  amountMinor   Int
  lineIds       String[]
  notes         String   @default("")
  status        String // requested | done | cancelled
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  // The accounts list (legacy Refund Orders List): who refunded it and the payment provider's transaction id.
  transactionId  String?
  refundedAt     DateTime?
  refundedByName String?
  claimable      String? // claimable | non_claimable, set on damaged and defect refunds
  manual         Boolean   @default(false) // added by hand on the list, already refunded
  removedAt      DateTime?
  removedByName  String?

  @@unique([shop, clientKey])
  @@index([shop, orderId])
  @@index([shop, status, createdAt])
}

// Who opened an order's detail page last (shown on Order Detail). One row per order, replaced on each open.
model OrderOpen {
  shop      String
  orderId   String
  staffId   String
  staffName String
  openedAt  DateTime @default(now())

  @@id([shop, orderId])
}

// Each time staff open a delivery note for printing (the legacy "Delv. Notes Log": date and who).
model DeliveryNotePrint {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  printedById String
  printedBy   String
  printedAt   DateTime @default(now())

  @@index([shop, orderId, printedAt])
}

// How a brand's supplier is paid: "credit" or "proforma". Set by staff on the Brand terms screen; used by the payment reports.
model BrandTerms {
  shop          String
  brand         String
  terms         String
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@id([shop, brand])
}

// Free stock: items we already own (cancelled or returned goods and the like) that can be given to an order instead of buying again.
// qty is what is still available; 0 means used up. Blank warehouseCode shows as "FSS" + seq.
model FreeStock {
  id            String   @id @default(cuid())
  shop          String
  seq           Int      @default(autoincrement())
  itemType      String   @default("freeStock")
  sourceOrder   String?
  brand         String
  productName   String
  productCode   String
  qty           Int
  costMinor     Int?
  warehouseCode String?
  rma           String?
  remarks       String?
  creditFoc     String?
  status        String?
  collection    String?
  isCollected   Boolean  @default(false)
  addedById     String?
  addedByName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  allocations   FreeStockAllocation[]

  @@index([shop, itemType, qty])
  @@index([shop, brand, productCode])
}

// Free stock given to an order line. Creating one lowers FreeStock.qty; removing one puts it back. The database refuses to delete stock that has one.
model FreeStockAllocation {
  id            String    @id @default(cuid())
  shop          String
  freeStockId   String
  freeStock     FreeStock @relation(fields: [freeStockId], references: [id], onDelete: Restrict)
  orderId       String
  orderName     String
  lineId        String
  qty           Int
  unitCostMinor Int?
  addedById     String?
  addedByName   String?
  createdAt     DateTime  @default(now())

  @@index([shop, orderId])
  @@index([shop, lineId])
  @@index([freeStockId])
}

// Stock arriving in containers. qty is what is left to give out; addedQty is what arrived. costMinor is pounds, costDollarMinor the dollar price it came from.
model ContainerStock {
  id              String   @id @default(cuid())
  shop            String
  seq             Int      @default(autoincrement())
  sku             String?
  itemVendor      String
  containerRange  String?
  containerNo     String
  productName     String
  productCode     String
  warehouseCode   String?
  costDollarMinor Int?
  costMinor       Int?
  priceMinor      Int?
  delvCostMinor   Int?
  addedQty        Int
  qty             Int
  totalCbm        Float?
  expectedDate    DateTime?
  addedById       String?
  addedByName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  allocations     ContainerAllocation[]

  @@index([shop, containerNo])
  @@index([shop, productCode])
  @@index([shop, qty])
}

// Container stock given to an order line. Creating one lowers ContainerStock.qty; removing one puts it back. The database refuses to delete stock that has one.
model ContainerAllocation {
  id               String         @id @default(cuid())
  shop             String
  containerStockId String
  containerStock   ContainerStock @relation(fields: [containerStockId], references: [id], onDelete: Restrict)
  orderId          String
  orderName        String
  lineId           String
  qty              Int
  unitCostMinor    Int?
  addedById        String?
  addedByName      String?
  createdAt        DateTime       @default(now())

  @@index([shop, orderId])
  @@index([shop, lineId])
  @@index([containerStockId])
}

// Freight paid for one container from one vendor. Several entries for the same container add up.
model ContainerFreight {
  id           String   @id @default(cuid())
  shop         String
  itemVendor   String
  containerNo  String
  freightMinor Int
  addedById    String?
  addedByName  String?
  createdAt    DateTime @default(now())

  @@index([shop, containerNo])
}

// Staff who have opened the app, and which restricted actions each may do. Until someone has "manage_permissions", nobody is restricted.
model StaffMember {
  id         String   @id @default(cuid())
  shop       String
  staffId    String
  name       String
  keys       String[] @default([])
  lastSeenAt DateTime @default(now())
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, staffId])
}

// How to order from one brand's supplier: where the order form goes, who is copied, and whether staff order by hand (no email).
model SupplierContact {
  id          String   @id @default(cuid())
  shop        String
  brand       String
  email       String?
  cc          String?
  handOrdered Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@unique([shop, brand])
}

// When a line was last chased with its supplier (the legacy "Last Chaseup" date).
model LineChase {
  id           String   @id @default(cuid())
  shop         String
  lineId       String
  orderId      String
  lastChasedAt DateTime
  chasedByName String?

  @@unique([shop, lineId])
  @@index([shop, orderId])
}

// Delivery fleet lists, typed in by staff on the Van Management page (the legacy van, driver and slot lists).
model Driver {
  id        String   @id @default(cuid())
  shop      String
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shop, name])
}

model Van {
  id        String   @id @default(cuid())
  shop      String
  name      String
  reg       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shop, name])
}

model DeliverySlot {
  id        String   @id @default(cuid())
  shop      String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shop, label])
}

// One delivery booking per order line (the legacy deliveryDateFinal, iVanId, iDriverId, iDrop, amPm).
model DeliveryBooking {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  partner       String   @default("CFS") // CFS (own vans) or a carrier: only CFS has van, driver and drop
  date          String // YYYY-MM-DD
  vanId         String?
  driverId      String?
  drop          Int?
  amPm          String? // AM | PM | ALL (All Day)
  slotId        String?
  bookedByName  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, lineId])
  @@index([shop, orderId])
  @@index([shop, date, vanId, drop])
}

// Every booking, reschedule and completion (the legacy delivery_booking_history).
model DeliveryHistory {
  id        String   @id @default(cuid())
  shop      String
  orderId   String
  lineId    String
  action    String // booked | rescheduled
  partner   String   @default("CFS")
  date      String?
  vanName   String?
  driverName String?
  drop      Int?
  amPm      String?
  reason    String?
  actorName String
  createdAt DateTime @default(now())

  @@index([shop, orderId, createdAt])
}
