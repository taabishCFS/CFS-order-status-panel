generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Read-only copy of Shopify orders, kept current by webhooks and the backfill. Money is in minor units (pence).
model Order {
  id               String   @id @default(cuid())
  shop             String
  orderId          String
  name             String
  createdAt        DateTime
  cancelledAt      DateTime?
  shopifyUpdatedAt DateTime
  customerName     String?
  email            String?
  shippingAddress  String?
  billingAddress   String?
  financialStatus  String?
  currency         String
  subtotalMinor    Int
  discountMinor    Int
  shippingMinor    Int
  totalMinor       Int
  tags             String[]
  sourceName       String?
  site             String?
  syncedAt         DateTime @default(now()) @updatedAt

  @@unique([shop, orderId])
  @@index([shop, createdAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  sku           String?
  vendor        String?
  variantTitle  String?
  title         String
  quantity      Int
  currency      String
  priceMinor    Int
  discountMinor Int
  properties    Json

  @@index([shop, orderId])
  @@index([shop, sku])
}

// One saved configuration of one configured order line. Version 1 is the original from the
// configurator; later versions are staff changes. The newest applied version is the current one.
model LineConfiguration {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineItemId    String
  version       Int
  source        String // original | staff
  configuration Json
  unitMinor     Int
  deltaMinor    Int      @default(0)
  status        String // pending | applied | failed
  reason        String?
  actorId       String?
  actorName     String?
  adjustment    Json?
  createdAt     DateTime @default(now())

  @@unique([shop, lineItemId, version])
  @@index([shop, orderId])
}
