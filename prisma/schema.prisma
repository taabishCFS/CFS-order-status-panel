generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Read-only copy of Shopify orders, kept current by webhooks and the backfill. Money is in minor units (pence).
model Order {
  id               String    @id @default(cuid())
  shop             String
  orderId          String
  name             String
  createdAt        DateTime
  cancelledAt      DateTime?
  shopifyUpdatedAt DateTime
  customerName     String?
  email            String?
  shippingAddress  String?
  billingAddress   String?
  financialStatus  String?
  currency         String
  subtotalMinor    Int
  discountMinor    Int
  shippingMinor    Int
  totalMinor       Int
  tags             String[]
  sourceName       String?
  site             String?
  orderStatusId    Int?
  gateway          String?
  outstandingMinor Int       @default(0)
  refundedMinor    Int       @default(0)
  phone            String?
  postcode         String?
  orderTakenBy     String?
  orderSource      String?
  archivedAt       DateTime?
  brands           String[]
  lineStatusIds    Int[]
  syncedAt         DateTime  @default(now()) @updatedAt

  @@unique([shop, orderId])
  @@index([shop, createdAt])
  @@index([shop, archivedAt, createdAt])
}

model OrderLine {
  id            String  @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  sku           String?
  vendor        String?
  variantTitle  String?
  productId     String?
  variantId     String?
  title         String
  quantity      Int
  currency      String
  priceMinor    Int
  discountMinor Int
  properties    Json
  lineStatusId    Int?
  expectedDate    String?
  deliveryOutcome String?
  orderCreatedAt  DateTime @default(now())
  orderArchived   Boolean  @default(false)

  @@index([shop, orderId])
  @@index([shop, sku])
  @@index([shop, vendor, orderCreatedAt])
  @@index([shop, lineStatusId])
}

// Supplier invoice details for one order line, entered by staff (the legacy "Supplier Invoice Update").
model LineSupplierInvoice {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineId        String
  invoiceDate   String? // YYYY-MM-DD
  invoiceNumber String?
  amountMinor   Int?
  paid          Boolean  @default(false)
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, lineId])
  @@index([shop, orderId])
}

// One saved configuration of one configured order line. Version 1 is the original from the
// configurator; later versions are staff changes. The newest applied version is the current one.
model LineConfiguration {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  lineItemId    String
  version       Int
  source        String // original | staff
  configuration Json
  unitMinor     Int
  deltaMinor    Int      @default(0)
  status        String // pending | applied | failed
  reason        String?
  actorId       String?
  actorName     String?
  adjustment    Json?
  createdAt     DateTime @default(now())

  @@unique([shop, lineItemId, version])
  @@index([shop, orderId])
}

// One email: queued, sent or failed. This table is both the queue and the send log.
model EmailOutbox {
  id              String    @id @default(cuid())
  shop            String
  orderId         String
  orderName       String
  templateKey     String
  templateVersion Int
  kind            String // customer | internal_copy | test
  recipient       String?
  from            String
  replyTo         String?
  subject         String
  html            String
  status          String // queued | sending | sent | failed | skipped
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  claimedAt       DateTime?
  mode            String? // log | test | live, as at send time
  providerId      String?
  error           String?
  actorId         String?
  actorName       String?
  dedupeKey       String
  createdAt       DateTime  @default(now())
  sentAt          DateTime?

  @@unique([shop, dedupeKey])
  @@index([shop, orderId])
  @@index([status, nextAttemptAt])
}

// An email template staff can edit. `version` is the current one; every save also writes an EmailTemplateVersion row.
model EmailTemplate {
  id            String   @id @default(cuid())
  shop          String
  key           String
  subject       String
  body          String
  version       Int      @default(1)
  updatedAt     DateTime @default(now()) @updatedAt
  updatedById   String?
  updatedByName String?

  @@unique([shop, key])
}

model EmailTemplateVersion {
  id        String   @id @default(cuid())
  shop      String
  key       String
  version   Int
  subject   String
  body      String
  reason    String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@unique([shop, key, version])
}

// One brand: its name, links, addresses and phone, used to fill templates for orders of that site.
model EmailSite {
  id                 String @id @default(cuid())
  shop               String
  code               String
  name               String
  url                String
  serviceEmail       String
  deliveriesEmail    String
  accountsEmail      String
  phone              String
  fromName           String
  deliveriesFromName String
  logoUrl            String

  @@unique([shop, code])
}

// A request to refund an order (all or part), entered by staff. Accounts act on the list; nothing here moves money.
model RefundRequest {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  orderName     String
  clientKey     String
  reason        String
  type          String // part | full
  amountMinor   Int
  lineIds       String[]
  notes         String   @default("")
  status        String // requested | done | cancelled
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  // The accounts list (legacy Refund Orders List): who refunded it and the payment provider's transaction id.
  transactionId  String?
  refundedAt     DateTime?
  refundedByName String?
  claimable      String? // claimable | non_claimable, set on damaged and defect refunds
  manual         Boolean   @default(false) // added by hand on the list, already refunded
  removedAt      DateTime?
  removedByName  String?

  @@unique([shop, clientKey])
  @@index([shop, orderId])
  @@index([shop, status, createdAt])
}

// Who opened an order's detail page last (shown on Order Detail). One row per order, replaced on each open.
model OrderOpen {
  shop      String
  orderId   String
  staffId   String
  staffName String
  openedAt  DateTime @default(now())

  @@id([shop, orderId])
}

// Each time staff open a delivery note for printing (the legacy "Delv. Notes Log": date and who).
model DeliveryNotePrint {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  printedById String
  printedBy   String
  printedAt   DateTime @default(now())

  @@index([shop, orderId, printedAt])
}

// How a brand's supplier is paid: "credit" or "proforma". Set by staff on the Brand terms screen; used by the payment reports.
model BrandTerms {
  shop          String
  brand         String
  terms         String
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@id([shop, brand])
}
